# Local development template. Do not put real secrets here.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=spec_research_loop
POSTGRES_USER=spec_research
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

API_PORT=4000
WEB_PORT=3000
STORAGE_PATH=./storage

LLM_PROVIDER=not-configured
LLM_MODEL=not-configured
ACADEMIC_API_BASE_URL=not-configured

# OpenAI-compatible LLM provider (consumed by apps/api/src/llm).
# OPENAI_API_KEY is required to make model calls; never commit real values.
OPENAI_API_KEY=not-configured
# Optional: point at an OpenAI-compatible gateway (e.g. local proxy). Leave
# unset to use the public OpenAI API.
OPENAI_BASE_URL=
# Optional: organization/project header when the provider requires it.
OPENAI_ORGANIZATION=
# Bounded request timeout and retry count (per docs/04-ai-system-design.md §13).
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Browser-side origin for the tRPC HTTP client. The client appends /trpc.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
