# Local development template. Do not put real secrets here.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=spec_research_loop
POSTGRES_USER=spec_research
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

API_PORT=4000
WEB_PORT=3000
STORAGE_PATH=./storage

LLM_PROVIDER=not-configured
LLM_MODEL=not-configured
ACADEMIC_API_BASE_URL=not-configured
# Browser-side origin for the tRPC HTTP client. The client appends /trpc.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
