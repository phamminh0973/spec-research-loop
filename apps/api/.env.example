# API service environment. Copy to .env (gitignored) for local overrides.
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# SQLite via Drizzle ORM + node:sqlite (https://orm.drizzle.team/docs/get-started/node-sqlite-new).
# - Set DATABASE_PATH to a file path for durability across restarts (e.g. ./data.db or /app/data/specloop.db in Docker).
# - Unset (or comment out) to run with an in-memory database (`:memory:`) — this is the mode every automated test uses.
# DB_FILE_NAME is an alias for DATABASE_PATH. DATABASE_URL is kept as a deprecated alias (ignored if it looks like a postgres URL).
# DATABASE_PATH=./data.db
# DATABASE_URL is deprecated — use DATABASE_PATH instead.
# DATABASE_URL=postgres://spec_research:change-me-locally@localhost:5432/spec_research_loop

# Local file storage root for uploaded PDFs.
STORAGE_PATH=./storage

# OpenAI-compatible provider settings.
# For the no-cost Gemini Free Tier, create a key in Google AI Studio and use
# it as OPENAI_API_KEY; the variable name is retained for SDK compatibility.
OPENAI_API_KEY=replace-with-your-gemini-api-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
