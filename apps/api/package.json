{
  "name": "@specloop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@specloop/api: eslint not configured yet\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@everdeep/arxiv": "^0.1.1",
    "@fastify/cors": "^11.3.0",
    "@specloop/schemas": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "^11.18.0",
    "build-md": "^0.4.6",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.11.3",
    "openai": "^7.4.0",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
